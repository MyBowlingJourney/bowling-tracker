<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: mybowlingjourney.com/app/... opens THE APP.

                 This replaces a custom-scheme filter
                 (com.mybowlingjourney.app://auth), which any web page
                 could navigate to and hand the app someone else's
                 session. An App Link cannot be forged that way: Android
                 checks /.well-known/assetlinks.json on the domain
                 against this app's signing certificate, and only links
                 to a domain that vouches for this exact app are
                 delivered here.

                 autoVerify is what triggers that check, at install
                 time. If assetlinks.json is missing, malformed, or
                 lists the wrong fingerprint, verification fails quietly
                 and links open in the browser instead, which is the
                 old behaviour rather than a broken one.

                 Scoped to /app because the domain root is the public
                 welcome page, which should stay in the browser: someone
                 who has not installed the app is the person that page is
                 for. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="mybowlingjourney.com"
                      android:pathPrefix="/app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- APPROXIMATE location only, for "centers near me" in the center
         picker. The WebView asks for it the first time a bowler searches;
         saying no still leaves typing a center in by name. Coarse, not
         fine, on purpose: a bowling alley is found fine to within a mile,
         and the Play Data Safety form declares approximate location.
         Adding ACCESS_FINE_LOCATION would make that declaration untrue. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>